<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <!-- Load order is important -->
    
    <!-- Initialize module -->
    <Script file="Init.lua"/>
    
    <!-- Load media -->
    <Script file="Media.lua"/>
    
    <!-- Load module components -->
    <Script file="Settings.lua"/>
    <Script file="MoveFrames.lua"/>
    <Script file="RegisterWidgets.lua"/>
    <Script file="VUIAnyFrame.lua"/>
    <Script file="VUI_Integration.lua"/>
    
    <!-- Include localization -->
    <Include file="Locales\Load.xml"/>
    
    <!-- Include elements -->
    <Include file="Ele\Load.xml" optional="true"/>
</Ui> 