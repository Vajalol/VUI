<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
  <!-- Button Template -->
  <Button name="VUIAuctionatorButtonTemplate" virtual="true">
    <Size x="120" y="22"/>
    <NormalFont style="GameFontNormal"/>
    <HighlightFont style="GameFontHighlight"/>
    <DisabledFont style="GameFontDisable"/>
    <NormalTexture file="Interface\Buttons\UI-Panel-Button-Up">
      <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
    </NormalTexture>
    <PushedTexture file="Interface\Buttons\UI-Panel-Button-Down">
      <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
    </PushedTexture>
    <DisabledTexture file="Interface\Buttons\UI-Panel-Button-Disabled">
      <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
    </DisabledTexture>
    <HighlightTexture file="Interface\Buttons\UI-Panel-Button-Highlight" alphaMode="ADD">
      <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
    </HighlightTexture>
  </Button>
  
  <!-- IconButton Template -->
  <Button name="VUIAuctionatorIconButtonTemplate" virtual="true">
    <Size x="32" y="32"/>
    <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
    <PushedTexture file="Interface\Buttons\UI-Quickslot-Depress"/>
  </Button>
  
  <!-- Tab Button Template -->
  <Button name="VUIAuctionatorTabButtonTemplate" virtual="true">
    <Size x="84" y="32"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentLeftDisabled" file="Interface\PaperDollInfoFrame\UI-Character-ActiveTab">
          <Size x="20" y="32"/>
          <Anchors>
            <Anchor point="TOPLEFT">
              <Offset x="0" y="5"/>
            </Anchor>
          </Anchors>
          <TexCoords left="0" right="0.15625" top="0" bottom="1.0"/>
        </Texture>
        <Texture name="$parentMiddleDisabled" file="Interface\PaperDollInfoFrame\UI-Character-ActiveTab">
          <Size x="44" y="32"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentLeftDisabled" relativePoint="RIGHT"/>
          </Anchors>
          <TexCoords left="0.15625" right="0.84375" top="0" bottom="1.0"/>
        </Texture>
        <Texture name="$parentRightDisabled" file="Interface\PaperDollInfoFrame\UI-Character-ActiveTab">
          <Size x="20" y="32"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentMiddleDisabled" relativePoint="RIGHT"/>
          </Anchors>
          <TexCoords left="0.84375" right="1.0" top="0" bottom="1.0"/>
        </Texture>
      </Layer>
    </Layers>
    <ButtonText name="$parentText">
      <Anchors>
        <Anchor point="CENTER">
          <Offset x="0" y="-3"/>
        </Anchor>
      </Anchors>
    </ButtonText>
    <NormalFont style="GameFontNormalSmall"/>
    <HighlightFont style="GameFontHighlightSmall"/>
    <DisabledFont style="GameFontHighlightSmall"/>
    <NormalTexture name="$parentLeft" file="Interface\PaperDollInfoFrame\UI-Character-InactiveTab">
      <Size x="20" y="32"/>
      <Anchors>
        <Anchor point="TOPLEFT"/>
      </Anchors>
      <TexCoords left="0" right="0.15625" top="0" bottom="1.0"/>
    </NormalTexture>
    <NormalTexture name="$parentMiddle" file="Interface\PaperDollInfoFrame\UI-Character-InactiveTab">
      <Size x="44" y="32"/>
      <Anchors>
        <Anchor point="LEFT" relativeTo="$parentLeft" relativePoint="RIGHT"/>
      </Anchors>
      <TexCoords left="0.15625" right="0.84375" top="0" bottom="1.0"/>
    </NormalTexture>
    <NormalTexture name="$parentRight" file="Interface\PaperDollInfoFrame\UI-Character-InactiveTab">
      <Size x="20" y="32"/>
      <Anchors>
        <Anchor point="LEFT" relativeTo="$parentMiddle" relativePoint="RIGHT"/>
      </Anchors>
      <TexCoords left="0.84375" right="1.0" top="0" bottom="1.0"/>
    </NormalTexture>
    <HighlightTexture name="$parentHighlight" file="Interface\PaperDollInfoFrame\UI-Character-Tab-Highlight" alphaMode="ADD">
      <Anchors>
        <Anchor point="TOPLEFT">
          <Offset x="10" y="5"/>
        </Anchor>
        <Anchor point="BOTTOMRIGHT">
          <Offset x="-10" y="0"/>
        </Anchor>
      </Anchors>
    </HighlightTexture>
  </Button>
  
  <!-- Auctionator Tab Button with Mixin -->
  <Button name="AuctionatorTabButtonTemplate" virtual="true" mixin="AuctionatorTabButtonMixin">
    <Size x="140" y="32"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentLeftCapTexture" parentKey="LeftCapTexture" file="Interface\PaperDollInfoFrame\UI-Character-InactiveTab">
          <Size x="20" y="32"/>
          <Anchors>
            <Anchor point="TOPLEFT"/>
          </Anchors>
          <TexCoords left="0" right="0.15625" top="0" bottom="1.0"/>
        </Texture>
        <Texture name="$parentRightCapTexture" parentKey="RightCapTexture" file="Interface\PaperDollInfoFrame\UI-Character-InactiveTab">
          <Size x="20" y="32"/>
          <Anchors>
            <Anchor point="TOPRIGHT"/>
          </Anchors>
          <TexCoords left="0.84375" right="1.0" top="0" bottom="1.0"/>
        </Texture>
        <Texture name="$parentMiddleTexture" parentKey="MiddleTexture" file="Interface\PaperDollInfoFrame\UI-Character-InactiveTab">
          <Size y="32"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativeKey="$parent.LeftCapTexture" relativePoint="TOPRIGHT" x="0" y="0"/>
            <Anchor point="TOPRIGHT" relativeKey="$parent.RightCapTexture" relativePoint="TOPLEFT" x="0" y="0"/>
          </Anchors>
          <TexCoords left="0.15625" right="0.84375" top="0" bottom="1.0"/>
        </Texture>
      </Layer>
      <Layer level="HIGHLIGHT">
        <Texture name="$parentHighlightTexture" parentKey="HighlightTexture" file="Interface\PaperDollInfoFrame\UI-Character-Tab-Highlight" alphaMode="ADD">
          <Size y="32"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="10" y="5"/>
            <Anchor point="TOPRIGHT" x="-10" y="5"/>
          </Anchors>
          <Color r="1" g="1" b="1" a="0.3"/>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <FontString name="$parentText" parentKey="Text" inherits="GameFontNormal">
          <Anchors>
            <Anchor point="CENTER" x="0" y="-3"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnClick method="OnClick"/>
      <OnEnter method="OnEnter"/>
      <OnLeave method="OnLeave"/>
    </Scripts>
    <NormalFont style="GameFontNormal"/>
    <HighlightFont style="GameFontHighlight"/>
  </Button>
  
  <Frame name="AuctionatorTabSelectedTemplate" virtual="true" mixin="AuctionatorTabSelectedMixin">
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentLeftSelectedTexture" parentKey="LeftSelectedTexture" file="Interface\PaperDollInfoFrame\UI-Character-ActiveTab">
          <Size x="20" y="32"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="0" y="0"/>
          </Anchors>
          <TexCoords left="0" right="0.15625" top="0" bottom="1.0"/>
        </Texture>
        <Texture name="$parentRightSelectedTexture" parentKey="RightSelectedTexture" file="Interface\PaperDollInfoFrame\UI-Character-ActiveTab">
          <Size x="20" y="32"/>
          <Anchors>
            <Anchor point="TOPRIGHT" x="0" y="0"/>
          </Anchors>
          <TexCoords left="0.84375" right="1.0" top="0" bottom="1.0"/>
        </Texture>
        <Texture name="$parentSelectedTexture" parentKey="SelectedTexture" file="Interface\PaperDollInfoFrame\UI-Character-ActiveTab">
          <Size y="32"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativeKey="$parent.LeftSelectedTexture" relativePoint="TOPRIGHT" x="0" y="0"/>
            <Anchor point="TOPRIGHT" relativeKey="$parent.RightSelectedTexture" relativePoint="TOPLEFT" x="0" y="0"/>
          </Anchors>
          <TexCoords left="0.15625" right="0.84375" top="0" bottom="1.0"/>
        </Texture>
      </Layer>
      <Layer level="HIGHLIGHT">
        <Texture name="$parentHighlightTexture" parentKey="HighlightTexture" file="Interface\PaperDollInfoFrame\UI-Character-Tab-Highlight" alphaMode="ADD">
          <Size y="32"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativeKey="$parent.LeftSelectedTexture" relativePoint="TOPRIGHT" x="0" y="0"/>
            <Anchor point="TOPRIGHT" relativeKey="$parent.RightSelectedTexture" relativePoint="TOPLEFT" x="0" y="0"/>
          </Anchors>
          <Color r="1" g="1" b="1" a="0.3"/>
        </Texture>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnShow method="OnShow"/>
      <OnHide method="OnHide"/>
    </Scripts>
  </Frame>
  
  <Frame name="AuctionatorTabFrameTemplate" virtual="true" mixin="AuctionatorTabFrameMixin">
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentBackground" parentKey="Background" setAllPoints="true">
          <Color r="0.1" g="0.1" b="0.1" a="0.8"/>
        </Texture>
      </Layer>
      <Layer level="BORDER">
        <Texture name="$parentBorder" parentKey="Border" setAllPoints="true">
          <Color r="0.6" g="0.6" b="0.6" a="0.5"/>
        </Texture>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnShow method="OnShow"/>
      <OnHide method="OnHide"/>
    </Scripts>
  </Frame>
  
  <!-- Tooltip Template -->
  <GameTooltip name="VUIAuctionatorTooltip" inherits="GameTooltipTemplate" parent="UIParent" hidden="true"/>
  
  <!-- EditBox Template -->
  <EditBox name="VUIAuctionatorEditBoxTemplate" autoFocus="false" virtual="true">
    <Size x="150" y="22"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentLeft" file="Interface\Common\Common-Input-Border">
          <Size x="8" y="22"/>
          <Anchors>
            <Anchor point="TOPLEFT"/>
          </Anchors>
          <TexCoords left="0" right="0.0625" top="0" bottom="0.625"/>
        </Texture>
        <Texture name="$parentMiddle" file="Interface\Common\Common-Input-Border">
          <Size x="134" y="22"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentLeft" relativePoint="RIGHT"/>
          </Anchors>
          <TexCoords left="0.0625" right="0.9375" top="0" bottom="0.625"/>
        </Texture>
        <Texture name="$parentRight" file="Interface\Common\Common-Input-Border">
          <Size x="8" y="22"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentMiddle" relativePoint="RIGHT"/>
          </Anchors>
          <TexCoords left="0.9375" right="1.0" top="0" bottom="0.625"/>
        </Texture>
      </Layer>
    </Layers>
    <FontString inherits="ChatFontNormal"/>
    <Scripts>
      <OnEscapePressed>
        self:ClearFocus()
      </OnEscapePressed>
      <OnEnterPressed>
        self:ClearFocus()
      </OnEnterPressed>
    </Scripts>
  </EditBox>
  
  <!-- Money Display Template -->
  <Frame name="VUIAuctionatorMoneyDisplayTemplate" virtual="true">
    <Size x="150" y="16"/>
    <Layers>
      <Layer level="ARTWORK">
        <FontString name="$parentGold" inherits="GameFontHighlight" text="0">
          <Anchors>
            <Anchor point="RIGHT" x="-30" y="0"/>
          </Anchors>
        </FontString>
        <FontString name="$parentSilver" inherits="GameFontHighlight" text="0">
          <Anchors>
            <Anchor point="RIGHT" x="-15" y="0"/>
          </Anchors>
        </FontString>
        <FontString name="$parentCopper" inherits="GameFontHighlight" text="0">
          <Anchors>
            <Anchor point="RIGHT" x="0" y="0"/>
          </Anchors>
        </FontString>
        <Texture name="$parentGoldTexture" file="Interface\MoneyFrame\UI-GoldIcon">
          <Size x="12" y="12"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentGold" relativePoint="RIGHT"/>
          </Anchors>
        </Texture>
        <Texture name="$parentSilverTexture" file="Interface\MoneyFrame\UI-SilverIcon">
          <Size x="12" y="12"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentSilver" relativePoint="RIGHT"/>
          </Anchors>
        </Texture>
        <Texture name="$parentCopperTexture" file="Interface\MoneyFrame\UI-CopperIcon">
          <Size x="12" y="12"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentCopper" relativePoint="RIGHT"/>
          </Anchors>
        </Texture>
      </Layer>
    </Layers>
  </Frame>
  
  <!-- Panel Template -->
  <Frame name="VUIAuctionatorPanelTemplate" inherits="BackdropTemplate" virtual="true">
    <KeyValues>
      <KeyValue key="backdropInfo" value="BACKDROP_DIALOG_32_32" type="global"/>
    </KeyValues>
  </Frame>
  
  <!-- Scroll Frame Template -->
  <ScrollFrame name="VUIAuctionatorScrollFrameTemplate" inherits="UIPanelScrollFrameTemplate" virtual="true">
    <Anchors>
      <Anchor point="TOPLEFT">
        <Offset x="16" y="-16"/>
      </Anchor>
      <Anchor point="BOTTOMRIGHT">
        <Offset x="-30" y="16"/>
      </Anchor>
    </Anchors>
    <ScrollChild>
      <Frame name="$parentScrollChild">
        <Size x="1" y="1"/>
      </Frame>
    </ScrollChild>
  </ScrollFrame>
  
  <!-- ScrollFrame Templates -->
  <ScrollFrame name="AuctionatorResultsScrollFrameTemplate" virtual="true">
    <Anchors>
      <Anchor point="TOPLEFT"/>
      <Anchor point="BOTTOMRIGHT"/>
    </Anchors>
    <ScrollChild>
      <Frame name="$parentScrollChild" parentKey="scrollChild">
        <Size x="1" y="1"/>
      </Frame>
    </ScrollChild>
    <Scripts>
      <OnVerticalScroll>
        if self.ScrollBar then
          self.ScrollBar:SetValue(offset);
        end
        if self.resultsListing then
          self.resultsListing:OnVerticalScroll(offset)
        end
      </OnVerticalScroll>
    </Scripts>
  </ScrollFrame>
  
  <Slider name="AuctionatorResultsScrollBarTemplate" inherits="UIPanelScrollBarTemplate" virtual="true">
    <Size x="16" y="0"/>
    <Anchors>
      <Anchor point="TOPRIGHT" x="0" y="-16"/>
      <Anchor point="BOTTOMRIGHT" x="0" y="16"/>
    </Anchors>
    <Scripts>
      <OnValueChanged>
        local parent = self:GetParent();
        parent:SetVerticalScroll(value);
        if parent.resultsListing then
          parent.resultsListing:OnVerticalScroll(value)
        end
      </OnValueChanged>
    </Scripts>
  </Slider>
  
  <!-- Results Row Templates -->
  <Button name="AuctionatorResultsListingRowTemplate" virtual="true">
    <Size x="0" y="20"/>
    <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" tile="true">
      <Color r="0" g="0" b="0" a="0.5"/>
      <BorderColor r="0.5" g="0.5" b="0.5"/>
      <Anchors>
        <Anchor point="TOPLEFT" x="0" y="0"/>
        <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
      </Anchors>
      <TileSize>
        <AbsValue val="4"/>
      </TileSize>
    </Backdrop>
    <HighlightTexture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD">
      <Color r="1" g="1" b="1" a="0.5"/>
      <Anchors>
        <Anchor point="TOPLEFT" x="0" y="0"/>
        <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
      </Anchors>
    </HighlightTexture>
  </Button>
  
  <Button name="AuctionatorLoadAllResultsButtonTemplate" virtual="true">
    <Size x="200" y="30"/>
    <Layers>
      <Layer level="OVERLAY">
        <FontString inherits="GameFontNormal" text="Load More Results">
          <Anchors>
            <Anchor point="CENTER" x="0" y="0"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <NormalTexture file="Interface\Buttons\UI-Button-Outline">
      <Color r="0.6" g="0.6" b="1" a="1"/>
    </NormalTexture>
    <HighlightTexture file="Interface\Buttons\UI-Button-Outline" alphaMode="ADD">
      <Color r="0.6" g="0.6" b="1" a="0.5"/>
    </HighlightTexture>
  </Button>
  
  <!-- Column Header Templates -->
  <Button name="AuctionatorColumnHeaderTemplate" virtual="true">
    <Size x="0" y="24"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentBackground" parentKey="Background" setAllPoints="true">
          <Color r="0.2" g="0.2" b="0.2" a="1"/>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <FontString name="$parentText" parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT">
          <Anchors>
            <Anchor point="LEFT" x="5" y="0"/>
            <Anchor point="RIGHT" x="-15" y="0"/>
          </Anchors>
        </FontString>
        <Texture name="$parentSortArrow" parentKey="SortArrow" hidden="true" file="Interface\MainMenuBar\UI-MainMenu-ArrowUp">
          <Size x="10" y="10"/>
          <Anchors>
            <Anchor point="RIGHT" x="-5" y="0"/>
          </Anchors>
        </Texture>
      </Layer>
    </Layers>
  </Button>

  <!-- Listing Template (for auction results) -->
  <Button name="VUIAuctionatorListingTemplate" virtual="true">
    <Size x="568" y="20"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentHighlight" setAllPoints="true" hidden="true">
          <Color r="1" g="1" b="1" a="0.2"/>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <FontString name="$parentName" inherits="GameFontHighlight" justifyH="LEFT">
          <Size x="200" y="20"/>
          <Anchors>
            <Anchor point="LEFT" x="5" y="0"/>
          </Anchors>
        </FontString>
        <FontString name="$parentQuantity" inherits="GameFontHighlight" justifyH="RIGHT">
          <Size x="40" y="20"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentName" relativePoint="RIGHT" x="10" y="0"/>
          </Anchors>
        </FontString>
        <FontString name="$parentPrice" inherits="GameFontHighlight" justifyH="RIGHT">
          <Size x="100" y="20"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentQuantity" relativePoint="RIGHT" x="10" y="0"/>
          </Anchors>
        </FontString>
        <FontString name="$parentUnitPrice" inherits="GameFontHighlight" justifyH="RIGHT">
          <Size x="100" y="20"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentPrice" relativePoint="RIGHT" x="10" y="0"/>
          </Anchors>
        </FontString>
        <FontString name="$parentTimeLeft" inherits="GameFontHighlight" justifyH="RIGHT">
          <Size x="80" y="20"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentUnitPrice" relativePoint="RIGHT" x="10" y="0"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <HighlightTexture alphaMode="ADD">
      <Color r="0.3" g="0.3" b="0.3" a="0.3"/>
    </HighlightTexture>
  </Button>
</Ui>